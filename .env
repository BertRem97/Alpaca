# Trading Bot Configuratie
# Kopieer dit bestand naar .env en vul je waarden in.
# ═══════════════════════════════════════════════════

# ── Alpaca API ──────────────────────────────────────
# Haal je API keys op: https://app.alpaca.markets/paper/dashboard/overview
# Standaard is paper trading (simulatie). Voor live trading,
# verander ALPACA_BASE_URL naar je live endpoint.
ALPACA_API_KEY= PK4VMRDFDVM7RIXFMQBAQCN6WF
ALPACA_SECRET_KEY= E5yjZPGY6SPWMqtbCUyJPzeDYDx8iMXfd1PJhhJCHQZr
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# ── Telegram Bot ────────────────────────────────────
# Maak een bot aan via @BotFather in Telegram.
# Haal je chat ID op via @userinfobot.
TELEGRAM_BOT_TOKEN=8918858188:AAE9ae4fH0tP9uCownHDX9vbtuvI5quJo3Q
TELEGRAM_CHAT_ID=6980285678

# ── Trading Instellingen ────────────────────────────
# Komma-gescheiden lijst van aandelen symbolen
TRADING_SYMBOLS=AAPL,MSFT,GOOGL,TLSA,AMZN,NVDA,META

# Strategie: "simple" (MA Crossover) of "advanced" (Multi-Indicator)
STRATEGY=advanced

# Moving Average periodes (in dagen) — gebruikt in beide strategieën
FAST_MA=10
SLOW_MA=30

# ── Advanced Strategie Instellingen ──────────────────
# RSI (Relative Strength Index)
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# MACD (Moving Average Convergence Divergence)
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger Bands
BB_PERIOD=20
BB_STD=2

# Volume gemiddelde periode
VOLUME_PERIOD=20

# Aantal aandelen per trade
TRADE_QUANTITY=1

# Hoe vaak (seconden) de bot de markt controleert
POLL_INTERVAL=300

# Start auto-trade bij opstarten (true/false)
AUTO_TRADE_ENABLED=false

